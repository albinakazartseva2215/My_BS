# Копия для локальной разработки: скопируйте этот файл в .env и подставьте
# свои значения. Сам .env в репозиторий не попадает (см. .gitignore).

# Окружение приложения: development | test | production
# seed.js намеренно отказывается запускаться при production — это защита
# от случайной перезаписи боевых данных тестовыми.
NODE_ENV=development

# Путь к файлу базы данных SQLite, относительно папки server/ (если не
# абсолютный). Если файла или папки ещё нет — connection.js создаст их сам
# при первом запуске.
# В контейнере (Dockerfile) значение по умолчанию другое — /data/database.sqlite,
# отдельный смонтированный том вне кода приложения, см. DEPLOY.md.
DATABASE_FILE=./data/database.sqlite

# Порт HTTP API.
PORT=3000

# Секрет для подписи сессионных токенов (см. src/security/session.js).
# Можно оставить пустым — тогда приложение само придумает его при первом
# запуске и сохранит в файл рядом с DATABASE_FILE (src/config/env.js), при
# следующих запусках будет читать его оттуда. Задавайте явно только если
# нужен конкретный секрет (например, перенос сессий на другой сервер).
SESSION_SECRET=

# Сколько дней действует сессия после входа.
SESSION_TTL_DAYS=30

# Срок жизни токена восстановления пароля, в минутах.
PASSWORD_RESET_TTL_MINUTES=30

# Только для production: e-mail первого администратора, которого
# приложение заводит само при старте на пустой базе (src/db/ensureAdmin.js) —
# больше неоткуда, публичная регистрация всегда выдаёт роль client, а
# npm run seed (демо-админ) в production не запускается. Пароль к нему в
# .env класть не нужно — он тоже придумывается сам и сохраняется в файл
# рядом с базой; задать ADMIN_PASSWORD можно, только если нужен конкретный
# пароль, а не сгенерированный.
# ADMIN_EMAIL=admin@ton-salon.local
# ADMIN_PASSWORD=

# Только для production: название/адрес/телефон салона, которыми
# приложение заполнит профиль салона (salon_profile) при старте на
# пустой базе (src/db/ensureSalonProfile.js) — без этой строки
# почти любой раздел (расчёт свободного времени, «Записи» в админке)
# отвечает 500, потому что рассчитан на то, что профиль уже есть, а
# заводил его раньше только npm run seed, который в production не
# запускается. Если не задать — подставятся заглушки, по которым видно,
# что это не настоящие данные ("Название салона", "Адрес не указан"),
# поменять их потом можно через PATCH /api/admin/salon-profile.
# SALON_NAME=Тон
# SALON_ADDRESS=г. Москва, ул. Тверская, 12
# SALON_PHONE=+7 999 123-45-67

# --- Вход через Яндекс (server/src/domain/yandexAuth.js) ---
#
# Идентификатор и секрет приложения — из кабинета разработчика Яндекса
# (https://oauth.yandex.ru → ваше приложение → вкладка со сведениями).
# Секрет — такой же настоящий секрет, как SESSION_SECRET выше: только в
# .env/переменных окружения сервера, никогда в коде и в git.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Адрес возврата (redirect_uri) — должен буквально совпадать с тем, что
# указано в настройках приложения на oauth.yandex.ru, включая протокол и
# путь: <ваш домен>/api/auth/yandex/callback (например,
# https://vcoding-alkazar.ru/api/auth/yandex/callback).
YANDEX_REDIRECT_URI=

# Длительность удержания слота (Booking · 3–5) НЕ здесь — это продуктовая
# настройка бронирования, а не секрет и не инфраструктура, поэтому она
# хранится в БД (salon_profile.hold_duration_minutes) и меняется через
# PATCH /api/admin/salon-profile, а не через .env — см. docs/db-schema.md,
# "Спорные решения", п.15.
