# Копия для локальной разработки: скопируйте этот файл в .env и подставьте
# свои значения. Сам .env в репозиторий не попадает (см. .gitignore).

# Окружение приложения: development | test | production
# seed.js намеренно отказывается запускаться при production — это защита
# от случайной перезаписи боевых данных тестовыми.
NODE_ENV=development

# Путь к файлу базы данных SQLite, относительно папки server/.
# Если файла или папки ещё нет — connection.js создаст их сам при первом запуске.
DATABASE_FILE=./data/database.sqlite

# Порт HTTP API.
PORT=3000

# Секрет для подписи сессионных токенов (см. src/security/session.js).
# Обязателен в production — сгенерировать, например:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# В development можно оставить пустым: сгенерируется случайный на процесс
# (сессии слетят при перезапуске сервера).
SESSION_SECRET=

# Сколько дней действует сессия после входа.
SESSION_TTL_DAYS=30

# На сколько минут придерживается слот (Booking · 3–5) до автоматического
# истечения, если запись не подтверждена.
HOLD_DURATION_MINUTES=10

# Срок жизни токена восстановления пароля, в минутах.
PASSWORD_RESET_TTL_MINUTES=30
