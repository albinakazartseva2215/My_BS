# Что не должно попасть в контекст сборки образа (server/Dockerfile).

# Зависимости ставятся внутри образа заново — свои node_modules с хостовой
# машины ему не нужны.
node_modules
npm-debug.log*

# Локальная база разработчика. Особенно важно: на сервере база лежит в
# смонтированном томе (DATABASE_FILE=/data/database.sqlite, см. Dockerfile
# и DEPLOY.md) — если тестовый файл попадёт в образ, его нечем будет
# перезаписать боевые данные, но лучше ему вообще не покидать машину
# разработчика.
data
*.sqlite
*.sqlite3
*.db

# Секреты и локальные настройки — в контейнере переменные окружения
# приходят от оркестратора (docker run -e / docker-compose / панель
# хостинга), а не из файла.
.env
.env.*
!.env.example

# История версий и служебные файлы редактора/ОС.
.git
.gitignore
.DS_Store
Thumbs.db
